{
  "name": "@wildtails/root",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/**\" --parallel run dev",
    "lint": "pnpm -r run lint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "vitest run --config apps/api/vitest.integration.config.ts",
    "test:e2e": "pnpm --filter @wildtails/web exec playwright test",
    "build": "pnpm -r run build",
    "openapi:lint": "redocly lint docs/api/openapi.yaml --format stylish"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
